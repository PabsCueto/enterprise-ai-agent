# Copia este archivo a .env y pon tu clave. NUNCA subas .env a GitHub.
# Puedes reutilizar la misma clave gratuita de Google AI Studio que usas en langgraph-agent-tools.
GEMINI_API_KEY=pon_tu_clave_aqui
# Usa el mismo modelo que en langgraph-agent-tools.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RAW_DOCS_DIR=./data/raw
# Similitud mínima (0 a 1) para que un fragmento cuente como relevante. Opcional.
MIN_SCORE=0.6
# Observabilidad (opcional). LOG_QUESTIONS=true escribe el texto de las preguntas en los logs: solo para depurar en local.
LOG_LEVEL=INFO
LOG_QUESTIONS=false
# Seguridad (opcional): peticiones por minuto y usuario en /ask y /agent.
RATE_LIMIT_PER_MIN=20
